      <div class="tgl">
        <div>
          <div class="tl" id="floorLabel">Floor exercises OK</div>
          <div class="ts" id="floorHelp">Floor press, plank drags…</div>
        </div>
        <button type="button" class="sw on" id="tgFloor" data-k="floor" role="switch"
