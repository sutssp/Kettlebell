<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BELLWORK — Kettlebell Pair Coach</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#14181d; --bg2:#191f26; --panel:#1e242d; --panel2:#232a34; --line:#2e3742;
  --chalk:#f1efe6; --dim:#98a2ae;
  --org:#ff7a29; --green:#3ddc84; --amber:#ffb224; --blue:#4aa8ff; --red:#ff5d5d;
  --c-squat:#56c8ff; --c-hinge:#ff9440; --c-push:#4ade80; --c-pull:#ffd23f;
  --c-core:#c084fc; --c-carry:#f472b6; --c-cond:#ff5d5d;
}
*{margin:0;padding:0;box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  font-family:'Barlow',sans-serif;color:var(--chalk);background:
  radial-gradient(1200px 600px at 85% -10%, rgba(255,122,41,.08), transparent 60%),
  radial-gradient(900px 500px at -10% 110%, rgba(74,168,255,.06), transparent 60%),
  var(--bg);
  min-height:100vh;
}
body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background-image:radial-gradient(rgba(241,239,230,.05) 1px, transparent 1.4px);
  background-size:26px 26px;}
#bgBell{position:fixed;right:-70px;bottom:-50px;width:440px;height:480px;color:var(--chalk);
  opacity:.045;z-index:0;pointer-events:none;animation:floaty 9s ease-in-out infinite}
@keyframes floaty{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-18px) rotate(2deg)}}
.wrap{max-width:1140px;margin:0 auto;padding:0 16px;position:relative;z-index:1}
.anton{font-family:'Anton',sans-serif;letter-spacing:.02em}
h1,h2,h3{font-family:'Anton',sans-serif;font-weight:400;letter-spacing:.03em}
button{font-family:'Barlow',sans-serif}
::selection{background:var(--org);color:#1c1005}

/* Screen-reader-only text: hidden visually, still announced */
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;
  white-space:nowrap;border:0;clip-path:inset(50%)}

/* header */
#hdr{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--line)}
body.in-timer #hdr{display:none}
.logo{display:flex;align-items:center;gap:10px}
.logo svg{width:34px;height:37px;color:var(--org)}
.logo .word{font-family:'Anton';font-size:1.4rem;letter-spacing:.06em}
.logo .word em{color:var(--org);font-style:normal}
.logo small{display:block;font:600 .58rem 'Barlow';letter-spacing:.28em;color:var(--dim);text-transform:uppercase}
.hdr-btns{display:flex;gap:8px}

/* buttons */
.btn{font:600 .82rem/1 'Barlow';letter-spacing:.08em;text-transform:uppercase;padding:.85rem 1.1rem;
  border-radius:8px;border:1px solid var(--line);background:var(--panel2);color:var(--chalk);
  cursor:pointer;transition:.15s;display:inline-flex;gap:.5rem;align-items:center;justify-content:center}
.btn:hover{transform:translateY(-1px);border-color:#465361;background:#28303b}
.btn:active{transform:scale(.96)}
.btn-prime{background:var(--org);border-color:var(--org);color:#1c1005;font-weight:800;box-shadow:0 6px 22px rgba(255,122,41,.28)}
.btn-prime:hover{background:#ff8d47;box-shadow:0 8px 28px rgba(255,122,41,.42)}
.btn-danger{border-color:var(--red);color:var(--red);background:transparent}
.btn-danger:hover{background:rgba(255,93,93,.12);border-color:var(--red)}
.btn-xl{padding:1.05rem 1.5rem;font-size:.95rem}
.btn.mini{padding:.45rem .6rem;font-size:.68rem}

/* screens */
.screen{display:none}
.screen.on{display:block;animation:rise .35s ease both}
@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}

/* setup layout */
.setup-grid{display:grid;gap:28px;padding:34px 0 60px}
@media(min-width:980px){.setup-grid{grid-template-columns:1.05fr .95fr;gap:40px;padding:48px 0 70px}}
.eyebrow{font:800 .7rem 'Barlow';letter-spacing:.3em;text-transform:uppercase;color:var(--org);margin-bottom:14px}
.big-formula{display:flex;align-items:stretch;gap:8px;margin:6px 0 4px;flex-wrap:wrap}
.big-formula .blk{font-family:'Anton';font-size:clamp(2.6rem,8vw,4.6rem);line-height:1;padding:10px 14px;border-radius:10px}
.big-formula .plus{font-family:'Anton';font-size:clamp(1.8rem,5vw,3rem);align-self:center;color:var(--dim)}
.blk.a{background:rgba(61,220,132,.14);color:var(--green);border:1px solid rgba(61,220,132,.4)}
.blk.b{background:rgba(61,220,132,.14);color:var(--green);border:1px solid rgba(61,220,132,.4)}
.blk.r{background:rgba(74,168,255,.12);color:var(--blue);border:1px solid rgba(74,168,255,.4)}
.blk small{display:block;font:700 .55rem 'Barlow';letter-spacing:.2em;margin-top:4px;text-transform:uppercase;opacity:.8}
.tagline{color:var(--dim);font-size:1.02rem;max-width:44ch;margin:14px 0 24px}
.tagline b{color:var(--chalk)}

.qstart{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}
.qtile{background:linear-gradient(180deg,var(--panel),#1a2028);border:1px solid var(--line);border-radius:12px;
  padding:16px 8px 14px;text-align:center;cursor:pointer;transition:.18s;position:relative;overflow:hidden}
.qtile:hover{transform:translateY(-3px);border-color:var(--org);box-shadow:0 10px 30px rgba(0,0,0,.4)}
.qtile:active{transform:scale(.97)}
.qtile .qn{font-family:'Anton';font-size:clamp(1.7rem,4.5vw,2.4rem);color:var(--chalk)}
.qtile .qn span{color:var(--org);font-size:.55em}
.qtile .qs{font:600 .64rem 'Barlow';color:var(--dim);letter-spacing:.03em;margin-top:5px;line-height:1.4}
.qtile::after{content:'';position:absolute;left:0;right:0;bottom:0;height:3px;background:var(--org);
  transform:scaleX(0);transition:.25s;transform-origin:left}
.qtile:hover::after{transform:scaleX(1)}
#lastHint{font-size:.8rem;color:var(--dim);border-left:3px solid var(--org);padding:6px 10px;background:rgba(255,122,41,.06);border-radius:0 6px 6px 0}

/* console */
.console{background:linear-gradient(180deg,var(--panel),#1a2029);border:1px solid var(--line);border-radius:14px;padding:20px 18px 22px;box-shadow:0 20px 50px rgba(0,0,0,.35)}
.console h2{font-size:1.3rem;margin-bottom:4px}
.console .sub{font-size:.78rem;color:var(--dim);margin-bottom:6px}
.flabel{font:800 .68rem 'Barlow';letter-spacing:.18em;color:var(--dim);text-transform:uppercase;margin:1.15rem 0 .5rem;display:flex;align-items:center;gap:.5rem}
.flabel::before{content:'';width:8px;height:8px;background:var(--org);flex:none}
.seg{display:flex;background:#12161b;border:1px solid var(--line);border-radius:9px;padding:4px;gap:4px}
.seg button{flex:1;border:0;background:transparent;color:var(--dim);font:700 .76rem 'Barlow';letter-spacing:.05em;
  text-transform:uppercase;padding:.6rem .3rem;border-radius:6px;cursor:pointer;transition:.15s}
.seg button:hover{color:var(--chalk)}
.seg button.on{background:var(--chalk);color:#14181d;box-shadow:0 2px 8px rgba(0,0,0,.35)}
.seg button small{display:block;font-weight:500;text-transform:none;letter-spacing:0;opacity:.7;font-size:.64rem;margin-top:2px}
.chips{display:flex;flex-wrap:wrap;gap:7px}
.chip{border:1px solid var(--line);background:#12161b;color:var(--dim);padding:.48rem .8rem;border-radius:999px;
  font:600 .76rem 'Barlow';cursor:pointer;transition:.15s;letter-spacing:.03em}
.chip:hover{border-color:#4a5665;color:var(--chalk)}
.chip.on{background:var(--org);border-color:var(--org);color:#1c1005;transform:scale(1.05)}
.chip.warn.on{background:var(--red);border-color:var(--red);color:#fff}
/* Row padding trimmed slightly so the taller 44px switch keeps the block's original density */
.tgl{display:flex;justify-content:space-between;align-items:center;padding:.3rem 0;border-bottom:1px dashed var(--line);gap:12px}
.tgl:last-of-type{border-bottom:0}
.tgl .tl{font-weight:600;font-size:.88rem}
.tgl .ts{font-size:.7rem;color:var(--dim)}
/* Switch: native <button>. The visible 46×26 track is drawn on ::before so the button
   itself can be 44px tall (touch target) without changing the visual design. */
.sw{position:relative;width:46px;min-height:44px;padding:0;border:0;background:transparent;
  appearance:none;-webkit-appearance:none;font:inherit;cursor:pointer;flex:none}
.sw::before{content:'';position:absolute;top:50%;left:0;transform:translateY(-50%);
  width:46px;height:26px;border-radius:99px;background:#2c343f;border:1px solid var(--line);
  box-sizing:border-box;transition:background .2s,border-color .2s}
.sw::after{content:'';position:absolute;top:50%;left:0;width:20px;height:20px;border-radius:50%;
  background:#8b96a3;transform:translate(2px,-50%);transition:transform .2s,background .2s}
.sw.on::before{background:var(--green);border-color:var(--green)}
.sw.on::after{transform:translate(22px,-50%);background:#0d1a12}
.sw:focus-visible{outline:3px solid var(--blue);outline-offset:4px;box-shadow:0 0 0 6px rgba(74,168,255,.18)}
.sw:disabled{cursor:not-allowed;opacity:.45}
@media (prefers-reduced-motion: reduce){
  .sw,.sw::before,.sw::after{transition:none}
}
.saved-box{margin-top:18px}
.saved-item{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:.6rem .8rem;border:1px solid var(--line);border-radius:8px;margin-bottom:7px;font-size:.8rem;background:#171d25}
.foot-note{margin-top:22px;font-size:.72rem;color:var(--dim);letter-spacing:.06em;text-transform:uppercase}

/* preview */
.pv-top{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;padding:22px 0 14px}
.pv-top h2{font-size:clamp(1.6rem,5vw,2.3rem)}
.pv-actions{display:flex;gap:8px;flex-wrap:wrap}
.meta-chips{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:14px}
.mchip{font:700 .68rem 'Barlow';letter-spacing:.06em;text-transform:uppercase;padding:.35rem .65rem;border-radius:6px;background:#12161b;border:1px solid var(--line);color:var(--dim)}
.mchip.hl{color:var(--org);border-color:rgba(255,122,41,.4)}
.safety{border:1px solid rgba(255,93,93,.45);background:rgba(255,93,93,.08);border-radius:10px;padding:12px 14px;font-size:.85rem;margin-bottom:16px;display:flex;gap:10px}
.safety .dot{width:10px;height:10px;border-radius:50%;background:var(--red);flex:none;margin-top:5px;animation:blink 1.6s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.card{background:linear-gradient(180deg,var(--panel),#1b212a);border:1px solid var(--line);border-radius:12px;padding:1rem 1.1rem;margin-bottom:12px}
.wc-card h3{font-size:1rem;letter-spacing:.06em;margin-bottom:8px;display:flex;align-items:center;gap:8px}
.wc-item{display:flex;justify-content:space-between;gap:10px;font-size:.84rem;padding:5px 0;border-bottom:1px dashed var(--line)}
.wc-item:last-child{border:0}
.wc-item .t{color:var(--dim);flex:none}
.bal{display:flex;align-items:center;gap:8px;margin:5px 0;font-size:.7rem}
.bal .bl{width:74px;flex:none;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--dim)}
.bal .bar{flex:1;height:9px;background:#12161b;border-radius:99px;overflow:hidden}
.bal .fill{height:100%;border-radius:99px;transition:width .5s}
.bal .bn{width:20px;text-align:right;color:var(--dim);flex:none}
.pair{border-left:4px solid var(--c,var(--org));position:relative}
.pair-h{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px}
.pair-no{font-family:'Anton';font-size:1.05rem;letter-spacing:.05em}
.ptype{font:700 .62rem 'Barlow';letter-spacing:.1em;text-transform:uppercase;color:var(--c,var(--org));
  background:color-mix(in srgb,var(--c,var(--org)) 14%, transparent);padding:.25rem .55rem;border-radius:4px}
.ptools{margin-left:auto;display:flex;gap:5px}
.exrow{padding:.7rem 0;border-top:1px dashed var(--line)}
.exrow .line1{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap}
.slot{font-family:'Anton';width:24px;height:24px;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;
  font-size:.85rem;flex:none;transform:translateY(3px)}
.slot.a{background:var(--green);color:#0b1a10}
.slot.b{background:var(--blue);color:#0a1626}
.exname{font-weight:800;font-size:1rem}
.durtag{font:700 .62rem 'Barlow';letter-spacing:.08em;color:var(--dim);border:1px solid var(--line);border-radius:4px;padding:.18rem .4rem;flex:none}
.wtag{font:700 .62rem 'Barlow';color:var(--org);flex:none}
.tag{font:700 .6rem 'Barlow';letter-spacing:.08em;padding:.2rem .45rem;border-radius:4px;text-transform:uppercase;
  background:color-mix(in srgb,var(--c,var(--dim)) 16%, transparent);color:var(--c,var(--dim));flex:none}
.mus{font-size:.72rem;color:var(--dim)}
.exrow .line2{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:6px}
.easier{font-size:.74rem;color:var(--dim)}
.easier b{color:var(--green);font-weight:600}
.restrow{border-top:1px dashed var(--line);padding:.55rem 0 0;font:700 .72rem 'Barlow';letter-spacing:.1em;color:var(--blue);text-transform:uppercase}
.stickyStart{position:sticky;bottom:0;padding:14px 0 18px;background:linear-gradient(transparent,var(--bg) 40%);display:flex;gap:10px;z-index:5}
.stickyStart .btn-prime{flex:1}

/* timer */
#scr-timer{min-height:100vh;display:none;flex-direction:column}
#scr-timer.on{display:flex}
#scr-timer{--ph:var(--green);transition:background .6s;
  background:radial-gradient(900px 560px at 50% -12%, color-mix(in srgb,var(--ph) 24%, transparent), transparent 72%),var(--bg)}
#scr-timer.ph-work{--ph:var(--green)}
#scr-timer.ph-amber{--ph:var(--amber)}
#scr-timer.ph-rest{--ph:var(--blue)}
#scr-timer.ph-warm{--ph:#2fd4b0}
#scr-timer.ph-cool{--ph:#7fb4ff}
.t-prog{height:5px;background:#12161b}
.t-prog i{display:block;height:100%;background:var(--ph);transition:width .3s;width:0}
.t-head{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;font:700 .78rem 'Barlow';letter-spacing:.12em;text-transform:uppercase;color:var(--dim)}
.t-head b{color:var(--chalk)}
.t-body{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:8px 16px;gap:6px;user-select:none;-webkit-user-select:none}
.stage{font:800 .8rem 'Barlow';letter-spacing:.28em;text-transform:uppercase;color:var(--ph);border:1.5px solid var(--ph);
  padding:.45rem 1.1rem;border-radius:999px;background:color-mix(in srgb,var(--ph) 12%, transparent)}
.ringwrap{position:relative;width:clamp(250px,64vw,360px);aspect-ratio:1;margin:8px 0}
.ringwrap svg{position:absolute;inset:0;transform:rotate(-90deg)}
.ring-bg{fill:none;stroke:#232a34;stroke-width:10}
.ring-fg{fill:none;stroke:var(--ph);stroke-width:10;stroke-linecap:round;transition:stroke .4s}
.bignum{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.bignum .n{font-family:'Anton';font-size:clamp(4.6rem,24vmin,8.5rem);line-height:.95}
.bignum .u{font:800 .7rem 'Barlow';letter-spacing:.34em;color:var(--dim);text-transform:uppercase;margin-top:2px}
#scr-timer.ph-amber .bignum .n{animation:pulse 1s infinite}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}
.t-name{font-family:'Anton';font-size:clamp(1.5rem,5.4vw,2.6rem);letter-spacing:.03em;max-width:22ch}
.t-side{font:700 .8rem 'Barlow';letter-spacing:.12em;text-transform:uppercase;color:var(--ph)}
.t-cue{font-size:.92rem;color:var(--dim);max-width:40ch}
.t-alt{font-size:.78rem;color:var(--dim)}
.t-alt b{color:var(--green);font-weight:600}
.t-next{margin-top:6px;font:700 .74rem 'Barlow';letter-spacing:.14em;text-transform:uppercase;color:var(--dim);
  border-top:1px dashed var(--line);padding-top:10px;max-width:90vw}
.t-next b{color:var(--chalk)}
.t-ctrls{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;padding:12px 14px calc(16px + env(safe-area-inset-bottom));max-width:640px;margin:0 auto;width:100%}
.tbtn{display:flex;flex-direction:column;align-items:center;gap:4px;padding:.7rem .3rem;border-radius:10px;border:1px solid var(--line);
  background:#1a2028;color:var(--chalk);cursor:pointer;font:700 .62rem 'Barlow';letter-spacing:.1em;text-transform:uppercase;transition:.15s}
.tbtn .ic{font-size:1.25rem;line-height:1}
.tbtn:hover{border-color:#4a5665;transform:translateY(-1px)}
.tbtn:active{transform:scale(.95)}
.tbtn.big{grid-column:span 1;background:var(--chalk);color:#14181d;border-color:var(--chalk)}
.tbtn.stop{color:var(--red);border-color:rgba(255,93,93,.5)}
#sideFlash{position:fixed;top:0;left:0;right:0;z-index:60;background:var(--amber);color:#241703;text-align:center;
  font-family:'Anton';font-size:clamp(1.3rem,5vw,2rem);letter-spacing:.12em;padding:.7rem;transform:translateY(-100%);transition:.25s}
#sideFlash.show{transform:none}

/* overlays */
.ov{position:fixed;inset:0;background:rgba(9,11,14,.85);backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;z-index:80;padding:18px}
.ov.on{display:flex}
.ov-card{background:linear-gradient(180deg,var(--panel),#1a2029);border:1px solid var(--line);border-radius:14px;padding:26px 22px;max-width:460px;width:100%;animation:rise .3s ease both;text-align:center}
.ov-card h3{font-size:1.6rem;margin-bottom:10px}
.ov-card.red{border-color:rgba(255,93,93,.55)}
.ov-card.red h3{color:var(--red)}
.ov-card p{color:var(--dim);font-size:.9rem;margin-bottom:16px;line-height:1.5}
.eff-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:14px 0 6px}
.eff-grid button{font-family:'Anton';font-size:1.3rem;padding:.65rem 0;border-radius:8px;border:1px solid var(--line);background:#12161b;color:var(--chalk);cursor:pointer;transition:.12s}
.eff-grid button:hover{background:var(--org);color:#1c1005;border-color:var(--org);transform:scale(1.07)}
.eff-labels{display:flex;justify-content:space-between;font:600 .62rem 'Barlow';letter-spacing:.1em;color:var(--dim);text-transform:uppercase}
.ov-btns{display:flex;gap:10px;margin-top:14px}
.ov-btns .btn{flex:1}
textarea{width:100%;background:#12161b;border:1px solid var(--line);border-radius:8px;color:var(--chalk);padding:10px;font:500 .88rem 'Barlow';min-height:70px;resize:vertical}
textarea:focus{outline:none;border-color:var(--org)}

/* done */
.done-wrap{max-width:640px;margin:0 auto;padding:40px 0 70px;text-align:center}
.done-wrap h2{font-size:clamp(2.6rem,10vw,4.5rem);color:var(--green)}
.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:22px 0}
.stat{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px 8px}
.stat .v{font-family:'Anton';font-size:1.7rem}
.stat .l{font:700 .6rem 'Barlow';letter-spacing:.14em;text-transform:uppercase;color:var(--dim);margin-top:3px}
.coach-line{background:rgba(61,220,132,.08);border:1px solid rgba(61,220,132,.35);border-radius:10px;padding:12px 14px;font-size:.88rem;margin:14px 0;text-align:left}

/* history */
.hist-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:20px 0}
.hcard{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px;margin-bottom:10px;display:flex;justify-content:space-between;gap:12px;align-items:flex-start;transition:.15s}
.hcard:hover{border-color:#465361;transform:translateY(-1px)}
.hcard .hd{font-weight:800}
.hcard .chips2{display:flex;flex-wrap:wrap;gap:6px;margin-top:7px}
.badge{font:700 .6rem 'Barlow';letter-spacing:.08em;text-transform:uppercase;padding:.22rem .5rem;border-radius:4px}
.badge.ok{background:rgba(61,220,132,.15);color:var(--green)}
.badge.part{background:rgba(255,178,36,.15);color:var(--amber)}
.hnote{font-size:.76rem;color:var(--dim);margin-top:7px;font-style:italic}
.empty{color:var(--dim);text-align:center;padding:40px 0;font-size:.9rem}

/* toast */
#toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--chalk);color:#14181d;
  font:700 .8rem 'Barlow';padding:.7rem 1.2rem;border-radius:99px;opacity:0;pointer-events:none;transition:.3s;z-index:99;max-width:90vw;text-align:center}
#toast.show{opacity:1;transform:translateX(-50%)}
@media(max-width:560px){
  .t-ctrls{grid-template-columns:repeat(5,1fr)}
  .qstart{gap:7px}
  .stat-grid,.hist-stats{grid-template-columns:repeat(3,1fr);gap:7px}
}
</style>
</head>
<body>

<svg id="bgBell" viewBox="0 0 120 130" fill="none">
