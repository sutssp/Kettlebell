/* ================= sound ================= */
let AC=null;
const S={muted:store.get('bw_mute',false)};
function ac(){if(!AC)AC=new (window.AudioContext||window.webkitAudioContext)();if(AC.state==='suspended')AC.resume();return AC;}
function tone(f,d=.12,type='square',g=.08,t0=0){if(S.muted)return;try{const c=ac(),o=c.createOscillator(),ga=c.createGain();
 o.type=type;o.frequency.value=f;const t=c.currentTime+t0;
 ga.gain.setValueAtTime(.0001,t);ga.gain.exponentialRampToValueAtTime(g,t+.012);ga.gain.exponentialRampToValueAtTime(.0001,t+d);
 o.connect(ga).connect(c.destination);o.start(t);o.stop(t+d+.06);}catch(e){}}
const SND={
 work(){tone(880,.1);tone(1318,.15,'square',.08,.13);},
 b(){tone(988,.1);tone(988,.16,'square',.08,.15);},
