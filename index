      <div class="big-formula">
        <div class="blk a">45<small>sec · work A</small></div><div class="plus">+</div>
        <div class="blk b">45<small>sec · work B</small></div><div class="plus">+</div>
        <div class="blk r">30<small>sec · rest</small></div>
