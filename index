 if(act==='dn'&&i<p.length-1)[p[i+1],p[i]]=[p[i],p[i+1]];
 if(act==='rp'){const a=findSwap(p[i],i,'a');const b2=findSwap({...p[i],a},i,'b');p[i]={a,b:b2,type:'CUSTOM'};}
 if(act==='swA'){const nx=findSwap(p[i],i,'a');state.useCount[nx.id]=(state.useCount[nx.id]||0)+1;p[i].a=nx;}
