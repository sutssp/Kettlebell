 rest(){tone(523,.18,'sine',.09);tone(392,.26,'sine',.09,.16);},
 restwarn(){tone(659,.09);tone(659,.09,'square',.07,.13);},
 done(){[523,659,784,1047].forEach((f,i)=>tone(f,.17,'triangle',.1,i*.15));}
};

