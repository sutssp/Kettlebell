  state.pool=buildPool();state.useCount={};state.cover={};
  pairs.forEach(p=>{[p.a,p.b].forEach(x=>{state.useCount[x.id]=(state.useCount[x.id]||0)+1;state.cover[x.cat]=(state.cover[x.cat]||0)+1;});});
  state.pairs=pairs;renderPreview();show('scr-preview');}
 if(e.target.dataset.del!=null){saved.splice(+e.target.dataset.del,1);store.set('bw_saved',saved);renderSaved();}
});

/* ================= timer engine ================= */
const T={segs:[],i:-1,seg:null,rem:0,run:false,paused:false,last:0,lastWhole:-1,elapsed:0,totalSec:0,loop:null};
let pairsDone=0,skips=0,swaps=0,efforts=[];
function buildTimeline(){
 const segs=[];
 if(cfg.warm)WARMS[cfg.dur].forEach(w=>segs.push({k:'warm',d:60,t:w[0],c:w[1],side:w[2]||null}));
 state.pairs.forEach((p,i)=>{segs.push({k:'work',slot:'A',d:45,pair:i,ex:p.a});
  segs.push({k:'work',slot:'B',d:45,pair:i,ex:p.b});segs.push({k:'rest',d:30,pair:i});});
 if(cfg.cool)COOLS[cfg.dur].forEach(w=>segs.push({k:'cool',d:60,t:w[0],c:w[1],side:w[2]||null}));
 return segs;
}
$('#btnStart').onclick=$('#btnStartTop').onclick=()=>{$('#ovSafety').classList.add('on');};
$('#btnGo').onclick=()=>{
 $('#ovSafety').classList.remove('on');ac();
 pairsDone=0;skips=0;swaps=0;efforts=[];
 T.segs=buildTimeline();T.i=-1;T.elapsed=0;T.totalSec=T.segs.reduce((s,x)=>s+x.d,0);
 T.run=true;T.paused=false;setPauseUI();show('scr-timer');
 advance();T.last=performance.now();
 clearInterval(T.loop);T.loop=setInterval(tick,100);
};
function tick(){
 if(!T.run||T.paused){T.last=performance.now();return;}
 const now=performance.now();T.rem-=(now-T.last)/1000;T.elapsed+=(now-T.last)/1000;T.last=now;
 const r=Math.ceil(T.rem);
 if(r!==T.lastWhole){T.lastWhole=r;onSecond(r);}
 if(T.rem<=0){advance();return;}
 renderTimer();
}
function onSecond(r){
 const seg=T.seg;if(!seg)return;
 if((seg.k==='work')&&r<=5&&r>0){SND.tick();vibrate(40);}
 if(seg.k==='rest'&&r===10)SND.restwarn();
 const needSwitch=(seg.ex&&seg.ex.side==='switch')||seg.side==='switch';
 if(needSwitch&&!seg.mid&&T.rem<=seg.d/2){seg.mid=true;SND.side();vibrate([80,60,80]);
  const f=$('#sideFlash');f.classList.add('show');setTimeout(()=>f.classList.remove('show'),1400);}
}
function enterSeg(seg){
 T.seg=seg;T.rem=seg.d;T.last=performance.now();T.lastWhole=Math.ceil(seg.d);seg.mid=false;
 const cls=seg.k==='work'?'ph-work':seg.k==='rest'?'ph-rest':seg.k==='warm'?'ph-warm':'ph-cool';
 $('#scr-timer').className='screen on '+cls;
 if(seg.k==='work'){seg.slot==='A'?SND.work():SND.b();vibrate(seg.slot==='A'?90:60);}
 else if(seg.k==='warm')SND.work();
 else SND.rest();
 renderTimer();
}
function advance(){
 const cur=T.segs[T.i];
 if(cur&&cur.k==='rest')pairsDone=cur.pair+1;
 T.i++;
 if(T.i>=T.segs.length){finish(true);return;}
 enterSeg(T.segs[T.i]);
 if(cur&&cur.k==='rest'&&pairsDone%4===0&&pairsDone<state.pairs.length){T.paused=true;setPauseUI();setTimeout(showEffort,350);}
}
function nextInfo(){
 const nx=T.segs[T.i+1];if(!nx)return'';
 if(nx.k==='work'&&nx.slot==='A'){const p=state.pairs[nx.pair];return`NEXT PAIR → <b>${p.a.n}</b> then <b>${p.b.n}</b>`;}
 if(nx.k==='work')return`NEXT → <b>${nx.ex.n}</b> — no break, move straight over`;
 if(nx.k==='rest')return'NEXT → <b>30s REST</b>';
 if(nx.k==='cool')return'NEXT → <b>COOL-DOWN</b> — you earned it';
 return'';
}
function renderTimer(){
 const seg=T.seg;if(!seg)return;
 const r=Math.max(0,Math.ceil(T.rem));
 $('#tNum').textContent=r;
 const scr=$('#scr-timer');
 if(seg.k==='work'){scr.classList.toggle('ph-amber',r<=5);scr.classList.toggle('ph-work',r>5);}
 $('#ringFg').style.strokeDasharray=CIRC;
 $('#ringFg').style.strokeDashoffset=CIRC*(1-Math.max(0,T.rem)/seg.d);
 const pill=seg.k==='warm'?'WARM-UP':seg.k==='cool'?'COOL-DOWN':seg.k==='rest'?'REST':'WORK · '+seg.slot;
 $('#stagePill').textContent=pill;
 $('#tPairInfo').textContent=seg.pair!=null?`PAIR ${seg.pair+1}/${state.pairs.length} · EX ${seg.pair*2+(seg.slot==='B'?2:1)}/${state.pairs.length*2}`:(seg.k==='warm'?'WARM-UP':'COOL-DOWN');
 let left=T.rem;for(let j=T.i+1;j<T.segs.length;j++)left+=T.segs[j].d;
 $('#tTotal').textContent=fmt(left);
 $('#tProg').style.width=Math.min(100,T.elapsed/T.totalSec*100)+'%';
 if(seg.k==='work'){
  const x=seg.ex;
  $('#tName').textContent=x.n;
  $('#tCue').textContent=x.cue;
  $('#tAlt').innerHTML=x.alt?`Easier option: <b>${EX[x.alt].n}</b>`:'';
  const ws=weightSuggest(x);$('#tCount').textContent=ws?ws+' · seconds':'seconds';
  $('#tSide').textContent=x.side==='switch'?(seg.mid?'▶ RIGHT SIDE — finish strong':'◀ START LEFT — switch at the beep'):x.side==='alt'?'↻ ALTERNATE SIDES EVERY REP':'';
 }else{
  $('#tName').textContent=seg.k==='rest'?'REST':seg.t;
  $('#tCue').textContent=seg.k==='rest'?'Shake it out. Breathe. Chalk up if you need it.':seg.c;
  $('#tAlt').innerHTML='';$('#tSide').textContent=(seg.side==='switch')?(seg.mid?'▶ SWITCH SIDE':'◀ SWITCH AT THE BEEP'):'';
  $('#tCount').textContent='seconds';
 }
 $('#tNext').innerHTML=nextInfo();
}
/* timer controls */
function setPauseUI(){$('#pauseIc').textContent=T.paused?'▶':'⏸';$('#pauseLb').textContent=T.paused?'Resume':'Pause';}
$('#cPause').onclick=()=>{T.paused=!T.paused;setPauseUI();};
$('#cSkip').onclick=()=>{if(!T.seg)return;if(T.seg.k==='work')skips++;toast('Skipped');advance();};
$('#cSwap').onclick=()=>{const seg=T.seg;if(!seg||seg.k!=='work')return toast('Nothing to replace right now');
 const p=state.pairs[seg.pair];const slot=seg.slot==='A'?'a':'b';
 const nx=findSwap(p,seg.pair,slot);if(nx.id===p[slot].id)return toast('No better option available');
 p[slot]=nx;seg.ex=nx;swaps++;renderTimer();toast('Replaced → '+nx.n);};
$('#cEnd').onclick=()=>{T.paused=true;setPauseUI();$('#ovEnd').classList.add('on');};
$('#btnStay').onclick=()=>{$('#ovEnd').classList.remove('on');T.paused=false;setPauseUI();};
$('#btnEndYes').onclick=()=>{$('#ovEnd').classList.remove('on');finish(false);};
function toggleMute(){S.muted=!S.muted;store.set('bw_mute',S.muted);
 $('#hdrSound').textContent=S.muted?'🔇':'🔊';$('#cMute').firstElementChild.textContent=S.muted?'🔇':'🔊';}
$('#hdrSound').onclick=toggleMute;$('#cMute').onclick=toggleMute;
$('#hdrSound').textContent=S.muted?'🔇':'🔊';
document.addEventListener('keydown',e=>{
 if(e.code==='Space'&&document.body.classList.contains('in-timer')&&!$$('.ov.on').length){e.preventDefault();$('#cPause').click();}});
/* effort check-in */
$('#effGrid').innerHTML=Array.from({length:10},(_,i)=>`<button data-v="${i+1}">${i+1}</button>`).join('');
function showEffort(){$('#ovEffort').classList.add('on');}
$('#effGrid').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;
 const v=+b.dataset.v;efforts.push(v);$('#ovEffort').classList.remove('on');
 T.paused=false;setPauseUI();T.last=performance.now();
 toast(v<=4?'Noted — we can push harder next time.':v>=9?'Noted — consider a lighter bell or easier variations.':'Right in the zone. Keep it up.');});

/* ================= finish / done / history ================= */
function finish(complete){
 clearInterval(T.loop);T.run=false;SND.done();vibrate([100,60,100,60,200]);
 const avg=efforts.length?Math.round(efforts.reduce((a,b)=>a+b,0)/efforts.length*10)/10:null;
 const rec={id:Date.now(),date:new Date().toISOString(),dur:cfg.dur,level:cfg.level,goal:cfg.goal,
  weights:[...cfg.weights].sort((a,b)=>a-b),pairsDone:pairsDone,pairsTotal:state.pairs.length,
  skipped:skips,replaced:swaps,efforts,avg,complete,notes:''};
 const h=store.get('bw_hist',[]);h.unshift(rec);store.set('bw_hist',h.slice(0,60));
 state.rec=rec;renderDone(rec);show('scr-done');refreshLastHint();
}
function renderDone(rec){
 $('#doneTitle').textContent=rec.complete?'DONE.':'LOGGED.';
 $('#doneTitle').style.color=rec.complete?'var(--green)':'var(--amber)';
 const mins=Math.round(rec.pairsDone*2);
 $('#doneStats').innerHTML=
  `<div class="stat"><div class="v">${rec.pairsDone}/${rec.pairsTotal}</div><div class="l">Pairs done</div></div>
   <div class="stat"><div class="v">${mins}'</div><div class="l">Work time</div></div>
   <div class="stat"><div class="v">${rec.avg?rec.avg:'–'}</div><div class="l">Avg effort</div></div>
   <div class="stat"><div class="v">${rec.skipped}</div><div class="l">Skipped</div></div>
   <div class="stat"><div class="v">${rec.replaced}</div><div class="l">Replaced</div></div>
   <div class="stat"><div class="v">${rec.weights.length?rec.weights.join('/'):'–'}</div><div class="l">Bells (kg)</div></div>`;
 let coach=rec.complete?'Session complete. ':'Session logged early — no judgement, come back stronger. ';
 if(rec.avg!=null){
  if(rec.avg<=4)coach+='Effort was low — next time try a heavier bell or harder variations.';
  else if(rec.avg>=9)coach+='That was a grinder — next time drop the weight, pick easier variations, or shorten the session.';
  else coach+='Effort was right in the zone — keep this level.';
 }
 coach+=' And remember: technique first, speed never.';
 $('#doneCoach').textContent='🧠 '+coach;
 $('#doneNote').value=rec.notes||'';
}
$('#btnNoteSave').onclick=()=>{const h=store.get('bw_hist',[]);const r=h.find(x=>x.id===state.rec.id);
 if(r){r.notes=$('#doneNote').value;store.set('bw_hist',h);toast('Notes saved');}};
$('#btnAgain').onclick=()=>{refreshLastHint();show('scr-setup');};
$('#btnHist2').onclick=$('#hdrHist').onclick=()=>{renderHistory();show('scr-history');};
$('#btnHBack').onclick=()=>show('scr-setup');
$('#btnClearH').onclick=()=>{if(confirm('Delete the entire training log?')){store.set('bw_hist',[]);renderHistory();}};
function renderHistory(){
 const h=store.get('bw_hist',[]);
 if(!h.length){$('#hStats').innerHTML='';$('#hList').innerHTML='<div class="empty">No sessions yet. Your first workout is one tap away.</div>';return;}
 const totMin=h.reduce((s,r)=>s+r.pairsDone*2,0);
 const avgs=h.filter(r=>r.avg).map(r=>r.avg);
 $('#hStats').innerHTML=
  `<div class="stat"><div class="v">${h.length}</div><div class="l">Sessions</div></div>
   <div class="stat"><div class="v">${Math.round(totMin/60*10)/10}h</div><div class="l">Work time</div></div>
   <div class="stat"><div class="v">${avgs.length?Math.round(avgs.reduce((a,b)=>a+b,0)/avgs.length*10)/10:'–'}</div><div class="l">Avg effort</div></div>`;
 $('#hList').innerHTML=h.map(r=>`<div class="hcard">
  <div style="flex:1">
   <div class="hd">${new Date(r.date).toLocaleDateString(undefined,{weekday:'short',day:'numeric',month:'short'})} · ${r.dur} min plan</div>
   <div class="chips2">
    <span class="badge ${r.complete?'ok':'part'}">${r.complete?'COMPLETE':r.pairsDone+'/'+r.pairsTotal+' PAIRS'}</span>
    <span class="mchip">${r.level}</span>
    ${r.avg?`<span class="mchip">effort ${r.avg}/10</span>`:''}
    ${r.weights.length?`<span class="mchip">🔔 ${r.weights.join('/')} kg</span>`:''}
    ${r.skipped?`<span class="mchip">${r.skipped} skipped</span>`:''}
    ${r.replaced?`<span class="mchip">${r.replaced} replaced</span>`:''}
   </div>
   ${r.notes?`<div class="hnote">“${r.notes}”</div>`:''}
  </div>
  <button class="btn mini btn-danger" data-hdel="${r.id}">✕</button></div>`).join('');
}
$('#hList').addEventListener('click',e=>{
 if(e.target.dataset.hdel){const h=store.get('bw_hist',[]).filter(r=>r.id!==+e.target.dataset.hdel);
  store.set('bw_hist',h);renderHistory();}});

/* ================= init ================= */
syncSwitches();
refreshQuick();renderSaved();refreshLastHint();
</script>
