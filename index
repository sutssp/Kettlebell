/* --- Accessible switches: cfg is the single source of truth --- */
function updateSwitch(switchButton, enabled) {
  switchButton.classList.toggle('on', enabled);
  switchButton.setAttribute('aria-checked', String(enabled));
  const status = switchButton.querySelector('.sr-only');
  if (status) {
    status.textContent = enabled ? 'On' : 'Off';
  }
}
function syncSwitches() {
  $$('.sw').forEach(switchButton => {
    const configKey = switchButton.dataset.k;
    updateSwitch(switchButton, Boolean(cfg[configKey]));
  });
}
// Native <button> handles mouse, touch, Enter and Space — one click listener is enough.
$$('.sw').forEach(switchButton => {
  switchButton.addEventListener('click', () => {
    const configKey = switchButton.dataset.k;
    cfg[configKey] = !cfg[configKey];
    updateSwitch(switchButton, cfg[configKey]);
    refreshQuick();
  });
});

