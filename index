    <button class="btn mini" data-act="sw${slot.toUpperCase()}" data-i="${i}">↺ swap</button></div></div>`;
  return `<div class="card pair" style="--c:${col}">
   <div class="pair-h"><span class="pair-no">PAIR ${i+1}</span><span class="ptype">${p.type}</span>
    <span class="ptools">
     <button class="btn mini" data-act="up" data-i="${i}" ${i===0?'disabled':''}>↑</button>
